{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://methodrail.dev/schemas/control-adapter.json",
  "title": "MethodrailControlAdapter",
  "description": "Project-local control interface through which Methodrail skills operate the real system.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "commands"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "web",
        "cli",
        "api",
        "library",
        "desktop",
        "service",
        "monorepo",
        "unknown"
      ]
    },
    "summary": { "type": "string" },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "doctor", "stop"],
      "properties": {
        "start": { "type": "string", "minLength": 1 },
        "doctor": { "type": "string", "minLength": 1 },
        "drive": { "type": "string" },
        "inspect": { "type": "string" },
        "capture": { "type": "string" },
        "reset": { "type": "string" },
        "stop": { "type": "string", "minLength": 1 }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check": { "type": "string" },
        "timeout_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "source_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preferred_existing_commands": {
      "type": "boolean",
      "description": "True when the adapter wraps existing project scripts rather than introducing new infrastructure."
    }
  }
}
