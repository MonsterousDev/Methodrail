{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://methodrail.dev/schemas/rigor.json",
  "title": "MethodrailRigorConfig",
  "description": "Rigor levels 0–5. Rigor is independent of task type.",
  "type": "object",
  "additionalProperties": false,
  "required": ["levels"],
  "properties": {
    "levels": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "id", "summary", "requirements"],
        "properties": {
          "level": { "type": "integer", "minimum": 0, "maximum": 5 },
          "id": { "type": "string" },
          "summary": { "type": "string" },
          "examples": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "typical_skills": {
            "type": "array",
            "items": { "type": "string" }
          },
          "forbidden_by_default": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
