{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://methodrail.dev/schemas/evidence.json",
  "title": "MethodrailEvidence",
  "description": "A single piece of evidence supporting a claim. Evidence is not a conclusion or a decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "claim_supported",
    "location",
    "captured_at",
    "producer",
    "freshness",
    "confidence"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "source",
        "test",
        "runtime",
        "trace",
        "profile",
        "benchmark",
        "history",
        "document",
        "human-decision",
        "static-analysis",
        "generated-artifact"
      ]
    },
    "claim_supported": { "type": "string", "minLength": 1 },
    "location": {
      "description": "Path, URL, command, artifact id, or other locator.",
      "type": "string",
      "minLength": 1
    },
    "revision": { "type": "string" },
    "captured_at": { "type": "string", "minLength": 1 },
    "producer": {
      "type": "string",
      "minLength": 1,
      "description": "Skill, tool, human, or command that produced this evidence."
    },
    "freshness": {
      "type": "string",
      "enum": ["fresh", "stale", "unknown"]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "inferred",
        "test-confirmed",
        "observed",
        "traced",
        "historically-confirmed",
        "unknown"
      ]
    },
    "notes": { "type": "string" }
  }
}
