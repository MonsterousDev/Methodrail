{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://methodrail.dev/schemas/context-packet.json",
  "title": "MethodrailContextPacket",
  "description": "Minimum sufficient context for the next operation. Prefer packets over accumulated chat.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "expected_outputs"],
  "properties": {
    "task": { "$ref": "https://methodrail.dev/schemas/task.json" },
    "question": { "type": "string" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "revision": { "type": "string" },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": { "type": "array", "items": { "type": "string" } },
        "decisions": { "type": "array", "items": { "type": "string" } },
        "behavior": { "type": "array", "items": { "type": "string" } },
        "operations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_only": { "type": "boolean" },
        "destructive_operations": { "type": "boolean" },
        "allowed_tools": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context_tokens": { "type": "integer", "minimum": 0 },
        "worker_count": { "type": "integer", "minimum": 1 },
        "latency": { "type": "string", "enum": ["low", "medium", "high"] },
        "cost": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "transition": {
      "type": "string",
      "enum": ["continue", "clear", "handoff", "isolate", "compact"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
