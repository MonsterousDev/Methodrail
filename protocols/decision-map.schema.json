{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://methodrail.dev/schemas/decision-map.json",
  "title": "MethodrailDecisionMap",
  "description": "Known territory, frontier, and fog for a task. Questions are not asked before their prerequisites are resolved.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "task_id", "nodes"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string" },
    "known": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Decision ids in known territory."
    },
    "frontier": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Decision ids ready to resolve (prerequisites known)."
    },
    "fog": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Decision ids whose prerequisites are unresolved."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://methodrail.dev/schemas/decision.json" }
    }
  }
}
