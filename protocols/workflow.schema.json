{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://methodrail.dev/schemas/workflow.json",
  "title": "MethodrailWorkflow",
  "description": "Declarative workflow. A workflow owns phase transitions; skills do not.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "summary", "kind", "entry", "states", "completion"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 8,
      "maxLength": 400
    },
    "kind": {
      "type": "string",
      "enum": ["investigation", "development", "debugging", "refactor", "review"]
    },
    "entry": { "type": "string", "minLength": 1 },
    "rigor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": "integer", "minimum": 0, "maximum": 5 },
        "default": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_code_modification": { "type": "boolean" },
        "require_evidence": { "type": "boolean" },
        "require_human_approval": { "type": "boolean" }
      }
    },
    "question_routing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "skills"],
        "properties": {
          "question": {
            "type": "string",
            "enum": ["how", "why", "observe", "prototype", "blast-radius", "domain"]
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "principles": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires"],
      "properties": {
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "kind"],
        "properties": {
          "description": { "type": "string", "minLength": 8 },
          "kind": {
            "type": "string",
            "enum": [
              "classify",
              "knowledge",
              "routing",
              "skill",
              "synthesize",
              "execute",
              "verify",
              "review",
              "gate",
              "observe",
              "decide"
            ]
          },
          "skills": {
            "type": "array",
            "items": { "type": "string" }
          },
          "selection": {
            "type": "string",
            "enum": ["all", "question-routing", "risk", "optional"]
          },
          "optional": { "type": "boolean" },
          "terminal": { "type": "boolean" },
          "on_complete": {
            "type": "array",
            "items": { "type": "string" }
          },
          "on_blocked": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
