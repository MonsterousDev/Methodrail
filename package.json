{
  "name": "methodrail",
  "version": "0.1.0",
  "description": "Evidence-driven software engineering methodology and skill system for AI coding agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "methodrail": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./routing": "./dist/routing/index.js",
    "./registry": "./dist/registry/index.js",
    "./validation": "./dist/validation/index.js"
  },
  "files": [
    "dist",
    "skills",
    "workflows",
    "protocols",
    "principles",
    "knowledge",
    "rigor",
    "adapters",
    "evals",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "validate": "tsx src/cli/index.ts validate",
    "eval": "tsx src/cli/index.ts eval",
    "check": "tsx src/cli/index.ts check",
    "generate-adapters": "tsx src/cli/index.ts generate-adapter all",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/methodrail/methodrail.git"
  },
  "keywords": [
    "agents",
    "skills",
    "methodology",
    "evidence",
    "verification",
    "ai-coding"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
